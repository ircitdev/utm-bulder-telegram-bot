# Configuration for UTM Telegram Bot

# Bot Token (get from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# URL of your URL shortening service
URL_SHORTENER_API=http://your-domain.com/yourls-api.php
URL_SHORTENER_SIGNATURE=your_yourls_signature_here

# Database settings (if using)
DATABASE_URL=sqlite:///utm_bot.db

# Redis settings (if using for state storage)
REDIS_URL=redis://localhost:6379/0

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Domain for the shortening server
BASE_URL=http://your-domain.com/

# Maximum UTM parameter length
MAX_UTM_PARAM_LENGTH=100

# HTTP request timeout (seconds)
HTTP_TIMEOUT=10